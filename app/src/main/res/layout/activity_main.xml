<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Hero. Carries its own gradient behind the status bar; the top inset is applied to
             this view in code so the gradient runs edge to edge. -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_gradient"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/heroGlyph"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_glyph_tile"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/hero_on_gradient" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Vidcollage.HeroTitle" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/tagline"
                android:textAppearance="@style/TextAppearance.Vidcollage.HeroBody" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Vidcollage.HeroBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_chip"
                    android:drawableStart="@drawable/ic_bolt"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/hero_on_gradient"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="@string/chip_on_device"
                    android:textColor="@color/hero_on_gradient"
                    android:textSize="12sp" />

                <TextView
                    style="@style/TextAppearance.Vidcollage.HeroBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_hero_chip"
                    android:drawableStart="@drawable/ic_check"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/hero_on_gradient"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="@string/chip_no_upload"
                    android:textColor="@color/hero_on_gradient"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickButton"
                style="@style/Widget.Vidcollage.Button.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/pick_videos"
                app:icon="@drawable/ic_video_library" />
        </LinearLayout>

        <!-- Progress. Pulled up so it overlaps the hero's rounded bottom edge. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/progressGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-18dp"
            android:layout_marginEnd="20dp"
            android:visibility="gone"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressRing"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:indicatorInset="2dp"
                            app:indicatorSize="48dp"
                            app:trackColor="?attr/colorSurfaceVariant"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="4dp" />

                        <TextView
                            android:id="@+id/progressPercent"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorPrimary"
                            tools:text="42%" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            tools:text="Detecting and embedding faces" />

                        <TextView
                            android:id="@+id/statusSubtext"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?android:attr/textColorSecondary"
                            tools:text="clip_one.mp4 · video 1 of 3" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelButton"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/cancel"
                        app:icon="@drawable/ic_close" />
                </LinearLayout>

                <!-- One bar per pipeline stage; they fill in as the run advances. -->
                <LinearLayout
                    android:id="@+id/stageStepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/stageDot0"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stage_dot_idle" />

                    <View
                        android:id="@+id/stageDot1"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stage_dot_idle" />

                    <View
                        android:id="@+id/stageDot2"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stage_dot_idle" />

                    <View
                        android:id="@+id/stageDot3"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stage_dot_idle" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- fillViewport + centre gravity: the empty state is short, and left at the top it
                 leaves a third of the screen blank under the steps. -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/emptyArt"
                        android:layout_width="216dp"
                        android:layout_height="143dp"
                        android:contentDescription="@null"
                        android:src="@drawable/img_empty_state" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/empty_title"
                        android:textAppearance="@style/TextAppearance.Vidcollage.EmptyTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_horizontal"
                        android:lineSpacingMultiplier="1.15"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/empty_hint"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?android:attr/textColorSecondary" />

                    <!-- The steps were loose on the background and read as stray text; a panel
                         with a heading makes them one piece of the page. -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Vidcollage.Card.Subtle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="18dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:text="@string/how_it_works"
                                android:textAppearance="@style/TextAppearance.Vidcollage.SectionLabel" />

                            <include
                                android:id="@+id/step1"
                                layout="@layout/item_how_it_works" />

                            <include
                                android:id="@+id/step2"
                                layout="@layout/item_how_it_works" />

                            <include
                                android:id="@+id/step3"
                                layout="@layout/item_how_it_works" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/resultsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="24dp"
                tools:listitem="@layout/item_result" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
